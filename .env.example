# ========================================================
# Antigravity Multi-Exchange Crypto Trading Terminal
# Environment Configuration Template (.env.example)
# NEVER commit real credentials to source control.
# ========================================================

# Platform Execution Mode: 'paper', 'testnet', 'live'
MODE=paper
ENVIRONMENT=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Relational Database Connection (SQLite local default / PostgreSQL production)
# SQLite example: sqlite+aiosqlite:///crypto_platform.db
# PostgreSQL example: postgresql+asyncpg://postgres:password@localhost:5432/crypto_terminal
DATABASE_URL=sqlite+aiosqlite:///crypto_platform.db

# Redis Cache / PubSub URL (optional in-memory fallback enabled)
REDIS_URL=redis://localhost:6379/0

# Security & Secret Encryption
# Fernet 32-byte URL-safe base64 encryption key for exchange API secrets at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=uO_fG7eR4o8m_N3K8v1k5y6L2z9P0q4s7t1w3x5y7z8=
JWT_SECRET=super-secret-jwt-signing-key-for-trading-terminal-sessions-2026

# Delta Exchange India API
# Production: https://api.india.delta.exchange | Testnet: https://testnet-api.delta.exchange
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_TESTNET_URL=https://testnet-api.delta.exchange
DELTA_WS_URL=wss://socket.india.delta.exchange
DELTA_API_KEY=
DELTA_API_SECRET=

# CoinSwitch PRO API
# Spot: https://coinswitch.co/trade/api/v2 | Futures: https://coinswitch.co/trade/api/v2/futures
COINSWITCH_SPOT_URL=https://coinswitch.co/trade/api/v2
COINSWITCH_FUTURES_URL=https://coinswitch.co/trade/api/v2/futures
COINSWITCH_WS_URL=wss://ws.coinswitch.co/
COINSWITCH_API_KEY=
COINSWITCH_API_SECRET=

# Global Risk Limits
MAX_ORDER_VALUE=500000.0
MAX_LEVERAGE=25
MAX_DAILY_LOSS=50000.0
MAX_POSITION_SIZE=2.0
MAX_SLIPPAGE=0.005
MAX_SPREAD=0.008
MAX_DATA_AGE_SECONDS=3.0
MAX_API_LATENCY_MS=800.0

# Funding Arbitrage Engine Defaults
ARBITRAGE_MIN_SPREAD=0.0008
ARBITRAGE_MIN_NET_EDGE=0.0003
ARBITRAGE_CONFIRMATION_SECONDS=5
MAX_ARBITRAGE_CAPITAL=200000.0
MAX_SIMULTANEOUS_ARBITRAGES=5

# Exchange Fee Rates (Maker / Taker)
DELTA_MAKER_FEE=0.0002
DELTA_TAKER_FEE=0.0005
COINSWITCH_MAKER_FEE=0.0002
COINSWITCH_TAKER_FEE=0.0005
